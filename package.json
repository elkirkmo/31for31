{
	"name": "31-for-31",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"migrate:data": "node --env-file=.env.local scripts/migrate-data-to-supabase.mjs",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:types": "supabase gen types typescript --local > src/database.generated.types.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^4.2.3",
		"@types/ws": "^8.18.1",
		"autoprefixer": "^10.4.20",
		"jsdom": "^29.1.1",
		"postcss": "^8.4.47",
		"supabase": "^2.113.0",
		"svelte": "^4.2.7",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.13",
		"typescript": "^5.0.0",
		"vite": "^5.0.3",
		"vitest": "^4.1.10"
	},
	"type": "module",
	"dependencies": {
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.106.2",
		"@vercel/analytics": "^1.3.1",
		"ws": "^8.21.0"
	}
}
