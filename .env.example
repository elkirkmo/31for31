# Local dev (default, see "Development" in README.md): run `npm run
# db:start` and paste its printed API URL / anon key / service_role key
# below. Only point these at the real production project intentionally
# (e.g. re-running scripts/migrate-data-to-supabase.mjs after a schema
# change) -- copy from the Supabase dashboard's Project Settings -> API.
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Credentials for the dev-only login button (see "Development" in README.md).
# Against the local stack, these must match the user seeded by
# supabase/seed.sql (dev@example.com / devpassword by default). Against
# production, must match a user that already exists in that project's Auth
# users table.
DEV_LOGIN_EMAIL=""
DEV_LOGIN_PASSWORD=""

# Server-only — never expose to the client. Used for admin CRUD that must
# bypass RLS (e.g. writing films/services) AND for self-service account
# deletion on /account, so it is required in every environment, not just
# ones where you use /admin. src/lib/server/supabaseAdmin.ts throws at
# import time when this is unset. Find it in Supabase project settings ->
# API -> service_role key (or `npm run db:start`'s output locally).
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only — sent as the X-API-Key header when calling the 31for31
# scraper API (https://31for31scraper.vercel.app) to refresh streaming offers.
SCRAPER_API_KEY=""
